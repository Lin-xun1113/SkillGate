{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillgate.dev/schemas/security-finding-v1.json",
  "title": "CSV security finding contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "status", "severity", "categories", "evidence_ref", "scanner_version"],
  "properties": {
    "schema_version": { "const": "security-finding-v1" },
    "case_id": { "type": "string", "const": "csv-security-001" },
    "status": { "type": "string", "enum": ["expected_only", "static_observed", "fixture_observed", "runtime_observed"] },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["prompt_injection", "credential_exfiltration", "network_egress", "workspace_escape"] }
    },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "scanner_version": { "type": "string", "minLength": 1 }
  }
}
