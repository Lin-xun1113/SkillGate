# Build stage for Go Control Plane
FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/skillgate ./cmd/skillgate

# Final runtime image
FROM alpine:3.21

WORKDIR /app
COPY --from=builder /bin/skillgate /usr/local/bin/skillgate
COPY experiments /app/experiments
COPY evals /app/evals
COPY skills /app/skills
COPY environments /app/environments
COPY policies /app/policies
COPY deploy/compose-bootstrap.sh /usr/local/bin/compose-bootstrap.sh
RUN chmod +x /usr/local/bin/compose-bootstrap.sh

EXPOSE 50051

ENTRYPOINT ["skillgate"]
CMD ["serve", "--grpc-addr", "0.0.0.0:50051"]
