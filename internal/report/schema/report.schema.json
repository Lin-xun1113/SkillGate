{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillGate Experiment Report",
  "type": "object",
  "required": ["schema", "experiment_id", "metadata", "summary", "case_results", "invalid_pairs", "statistical_method"],
  "properties": {
    "schema": { "type": "string" },
    "experiment_id": { "type": "string" },
    "status": { "type": "string", "enum": ["COMPLETED", "INCOMPLETE"] },
    "metadata": {
      "type": "object",
      "required": ["experiment_name", "created_at", "total_trials", "valid_pairs", "invalid_pairs"],
      "properties": {
        "experiment_name": { "type": "string" },
        "created_at": { "type": "string" },
        "total_trials": { "type": "integer", "minimum": 0 },
        "valid_pairs": { "type": "integer", "minimum": 0 },
        "invalid_pairs": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["mean_lift", "ci_lower", "ci_upper", "n_cases", "statistically_significant", "method", "num_resamples"],
      "properties": {
        "mean_lift": { "type": "number" },
        "ci_lower": { "type": "number" },
        "ci_upper": { "type": "number" },
        "n_cases": { "type": "integer", "minimum": 0 },
        "statistically_significant": { "type": "boolean" },
        "method": { "type": "string" },
        "num_resamples": { "type": "integer", "minimum": 0 }
      }
    },
    "case_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "baseline_score", "candidate_score", "difference"],
        "properties": {
          "case_id": { "type": "string" },
          "baseline_score": { "type": "number" },
          "candidate_score": { "type": "number" },
          "difference": { "type": "number" },
          "baseline_repetitions": { "type": "integer" },
          "candidate_repetitions": { "type": "integer" }
        }
      }
    },
    "pass_at_k": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "resource_usage": {
      "type": "object",
      "properties": {
        "token_delta": { "$ref": "#/definitions/resourceDelta" },
        "latency_delta": { "$ref": "#/definitions/resourceDelta" },
        "tool_call_delta": { "$ref": "#/definitions/resourceDelta" },
        "cost_delta": { "$ref": "#/definitions/resourceDelta" }
      }
    },
    "trigger": {
      "type": "object",
      "properties": {
        "recall": { "type": "number" },
        "specificity": { "type": "number" },
        "evaluated": { "type": "boolean" },
        "positive_cases": { "type": "integer", "minimum": 0 },
        "negative_cases": { "type": "integer", "minimum": 0 },
        "incomplete_cases": { "type": "integer", "minimum": 0 }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "confirmed_exploits": { "type": "integer", "minimum": 0 },
        "evaluated": { "type": "boolean" },
        "missing_evidence": { "type": "integer", "minimum": 0 },
        "probe_cases": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["complete", "identity_valid", "pairing_valid", "trigger_evaluated", "security_evaluated", "reliability_evaluated", "incomplete_trials"],
      "properties": {
        "complete": { "type": "boolean" },
        "identity_valid": { "type": "boolean" },
        "pairing_valid": { "type": "boolean" },
        "trigger_evaluated": { "type": "boolean" },
        "security_evaluated": { "type": "boolean" },
        "reliability_evaluated": { "type": "boolean" },
        "incomplete_trials": { "type": "integer", "minimum": 0 },
        "missing_evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trial_id"],
        "properties": {
          "trial_id": { "type": "string" },
          "case_id": { "type": "string" },
          "trace_ref": { "type": "string" },
          "artifact_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "invalid_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "reason"],
        "properties": {
          "case_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["result", "policy_hash", "snapshot_hash", "matched_rules", "evaluated_rules", "failed_conditions", "explanation"],
      "properties": {
        "result": { "type": "string", "enum": ["PROMOTE", "HOLD", "REJECT"] },
        "policy_hash": { "type": "string" },
        "snapshot_hash": { "type": "string" },
        "matched_rules": { "type": "array", "items": { "type": "string" } },
        "explanation": { "type": "string" }
      }
    },
    "statistical_method": {
      "type": "object",
      "required": ["bootstrap_method", "ci_method", "significance_level"],
      "properties": {
        "bootstrap_method": { "type": "string" },
        "ci_method": { "type": "string" },
        "significance_level": { "type": "number" }
      }
    }
  },
  "definitions": {
    "resourceDelta": {
      "type": "object",
      "properties": {
        "baseline_mean": { "type": "number" },
        "candidate_mean": { "type": "number" },
        "delta": { "type": "number" },
        "delta_ratio": { "type": "number" }
      }
    }
  }
}
