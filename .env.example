# 本文件只列出本地受控冒烟和 Compose 配置变量，不得填写或提交真实 Key。
# 默认 Compose 使用 deploy/secrets 下的合成 Demo Secret；Production 必须由
# Operator 显式提供外部文件路径（见 deploy/docker-compose.production.yml）。

# Optional local/demo overrides. Values are paths, not secret contents.
# SKILLGATE_POSTGRES_PASSWORD_FILE=./deploy/secrets/demo-postgres-password
# SKILLGATE_DATABASE_URL_FILE=./deploy/secrets/demo-database-url
# COMPOSE_PROFILES=            # 留空表示 Local Insecure Demo；生产使用 production

LIVE_PROVIDER_SMOKE=0
LIVE_PROVIDER=openai
LIVE_PROVIDER_MODEL=

OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# ANTHROPIC_BASE_URL=
