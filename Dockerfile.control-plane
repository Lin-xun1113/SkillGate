FROM golang:1.23-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build control plane
RUN CGO_ENABLED=1 go build -o /control-plane ./cmd/control-plane

FROM alpine:latest

# Install SQLite runtime
RUN apk add --no-cache sqlite-libs ca-certificates

# Copy binary
COPY --from=builder /control-plane /usr/local/bin/

# Create data directory
RUN mkdir -p /data /cas /artifacts

# Expose gRPC port
EXPOSE 50051

CMD ["control-plane"]
